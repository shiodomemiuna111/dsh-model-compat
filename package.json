{
  "name": "dsh-model-compat",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "Probe and declare third-party OpenAI-compatible model capabilities for DeepSeek Harness (dsh).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "probe": "node scripts/probe-capabilities.mjs",
    "check": "node scripts/resolve-check.mjs",
    "budget": "node scripts/context-budget.mjs",
    "inject": "node scripts/inject-model.mjs",
    "matrix": "node scripts/probe-matrix.mjs",
    "selfcheck": "npm test && node scripts/context-budget.mjs --ctx 800000 --max 65536 && node scripts/resolve-check.mjs --patch examples/cordis.patch.yml --plugin-root /opt/dsh/node_modules --lint --budget",
    "merge": "node scripts/merge-routes.mjs",
    "lint": "node scripts/resolve-check.mjs --lint",
    "test": "node --test test/regress.test.mjs"
  },
  "license": "MIT",
  "bin": {
    "dmc-probe": "scripts/probe-capabilities.mjs",
    "dmc-check": "scripts/resolve-check.mjs",
    "dmc-verify": "scripts/verify-effective.mjs",
    "dmc-repair": "scripts/repair.mjs",
    "dmc-merge": "scripts/merge-routes.mjs",
    "dmc-budget": "scripts/context-budget.mjs",
    "dmc-matrix": "scripts/probe-matrix.mjs",
    "dmc-inject": "scripts/inject-model.mjs"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "examples",
    "README.md"
  ]
}
